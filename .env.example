# Bu dosyayi .env adiyla kopyalayip degerleri degistirin:  cp .env.example .env
# .env git'e eklenmez (.gitignore).

# SQL Server sa sifresi: en az 8 karakter; buyuk harf, kucuk harf, rakam ve sembol icermeli.
DB_PASSWORD=Degistir_Beni_123!

# JWT imza anahtari: en az 32 karakter, tahmin edilemez olmali.
# Uretmek icin:  openssl rand -base64 48
JWT_SECRET=buraya-en-az-32-karakterlik-rastgele-bir-deger-yazin

# Panelin yayinlanacagi port (yerelde http://localhost:8080)
WEB_PORT=8080

# true: ornek verili demo otel olusturulur ve giris ekraninda "Demo hesabiyla dene" butonu cikar.
# Portfoy/canli demo icin true; gercek musteri kurulumunda false.
DEMO_MODE=false

# --- Sadece canli sunucuda (docker-compose.prod.yml) ---
# GitHub kullanici adi, kucuk harflerle: imajlar ghcr.io/<IMAGE_OWNER>/stayflow-api
# IMAGE_OWNER=kullaniciadi
